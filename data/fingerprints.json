
{
  "banner_rules": [
    {
      "tags": ["redis"],
      "prefix": "+PONG"
    },
    {
      "tags": ["redis"],
      "prefix": "-ERR"
    },
    {
      "tags": ["mysql"],
      "hex_prefix": "4a0000"
    },
    {
      "tags": ["mongodb"],
      "hex_prefix": "3d000000"
    },
    {
      "tags": ["elasticsearch", "elastic"],
      "prefix": "{\"name\""
    },
    {
      "tags": ["memcached"],
      "prefix": "VERSION"
    },
    {
      "tags": ["ftp"],
      "prefix": "220"
    },
    {
      "tags": ["ssh"],
      "prefix": "SSH-"
    },
    {
      "tags": ["smtp"],
      "prefix": "220 "
    },
    {
      "tags": ["rdp"],
      "hex_prefix": "030000"
    },
    {
      "tags": ["zookeeper"],
      "prefix": "Zookeeper"
    }
  ]
}
